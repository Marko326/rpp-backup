# precompiled python
*.pyc

# compiled object file
*.o

# no binaries
*.exe

# no zip
*.zip

# roms
*.gbc
*.gb

# rgbds extras
*.sym

# converted image data
*.2bpp
*.1bpp
*.pic

# swap files for vim
.*.swp

# JSON inputs/contracts are source files and must remain visible to Git.
# Keep only disposable JSON in explicitly scoped output/cache directories.
# Do not put source manifests or provenance files in these directories.
extras/**/*.json
tools/generated_reports/**/*.json
tools/cache/**/*.json

# for any of the poor souls with save game files in their working directory
*.sgm
*.sav
*.sys
*.rtc

# for vim configuration
# url: http://www.vim.org/scripts/script.php?script_id=441
.lvimrc

# ignore GlitchMap files, since that shouldn't really be out and about yet
GlitchMap/data.js

# ignore .map files in main folder
pokered.map
pokeblue.map
patches/rppblue.map
patches/rppred.map

# ignore local rgbds
rgbds/*

# ignore sync files
.verysync/
